## Public release — selective overrides

# Data: exclude images/masks/manifests; splits/*.txt are tracked explicitly
data_pipeline/datasets/*/Images/
data_pipeline/datasets/*/Masks/
data_pipeline/datasets/*/manifest.json
data_pipeline/datasets/*/clusters.json

# KML — keep only Lahore (user-created); exclude third-party sources
data_pipeline/kmls/
!data_pipeline/kmls/lahore.kml

